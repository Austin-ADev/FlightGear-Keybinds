     "release": [{"cmd": "property-assign", "prop": "/sim/time/warp-delta", "value": "0"}],
     "match": [["^prop=sim/time/warp-delta$", "^step=-"]]},
    {"id": "sim.replay", "cat": "Simulateur", "label": "Rejeu instantané", "kind": "button",
