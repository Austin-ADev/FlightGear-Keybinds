    {"id": "sim.visibility-down", "cat": "Simulateur", "label": "Réduire la visibilité", "kind": "button", "repeatable": true,
     "press": [{"cmd": "nasal", "script": "environment.decreaseVisibility()"}]},

    {"id": "comms.ptt", "cat": "Communications", "label": "Alternat radio (push-to-talk)", "kind": "button",
