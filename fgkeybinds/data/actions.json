     "press": [{"cmd": "nasal", "script": "controls.incAileron(0.05, 1.0)"}],
     "match": [["incAileron\\(\\s*\\+?[0-9.]"], ["^cmd=property-adjust$", "^prop=controls/flight/aileron$", "^step=\\+?[0-9.]"]]},
    {"id": "flight.elevator-up", "cat": "Flight controls", "label": "Profondeur : tirer (cabrer)", "kind": "button", "repeatable": true,
     "press": [{"cmd": "nasal", "script": "controls.incElevator(-0.05, 100)"}],
     "match": [["incElevator\\(\\s*-"], ["^cmd=property-adjust$", "^prop=controls/flight/elevator$", "^step=-"]]},
    {"id": "flight.elevator-down", "cat": "Flight controls", "label": "Profondeur : pousser (piquer)", "kind": "button", "repeatable": true,
     "press": [{"cmd": "nasal", "script": "controls.incElevator(0.05, -100)"}],
     "match": [["incElevator\\(\\s*\\+?[0-9.]"], ["^cmd=property-adjust$", "^prop=controls/flight/elevator$", "^step=\\+?[0-9.]"]]},
