     "match": [["^prop=sim/current-view/view-number$", "^value=0"], ["setView\\(\\s*0"]]},
    {"id": "view.reset", "cat": "Vues", "label": "Réinitialiser la vue", "kind": "button",
     "press": [{"cmd": "nasal", "script": "view.resetView()"}]},
    {"id": "view.zoom-in", "cat": "Vues", "label": "Zoom avant (réduire le champ de vision)", "kind": "button", "repeatable": true,
     "press": [{"cmd": "nasal", "script": "view.decrease()"}], "match": [["view\\.decrease\\("]]},
    {"id": "view.zoom-out", "cat": "Vues", "label": "Zoom arrière (élargir le champ de vision)", "kind": "button", "repeatable": true,
     "press": [{"cmd": "nasal", "script": "view.increase()"}], "match": [["view\\.increase\\("]]},
    {"id": "view.zoom-reset", "cat": "Vues", "label": "Zoom par défaut", "kind": "button",
     "press": [{"cmd": "nasal", "script": "view.resetFOV()"}],
     "match": [["resetFOV"], ["^prop=sim/current-view/field-of-view$", "default-field-of-view"]]},
    {"id": "view.pan-left", "cat": "Vues", "label": "Tourner la tête à gauche", "kind": "button", "repeatable": true,
     "press": [{"cmd": "nasal", "script": "view.panViewDir(1)"}],
     "match": [["panViewDir\\(\\s*\\+?[0-9.]"], ["^cmd=property-adjust$", "^prop=sim/current-view/goal-heading-offset-deg$", "^step=\\+?[0-9.]"]]},
    {"id": "view.pan-right", "cat": "Vues", "label": "Tourner la tête à droite", "kind": "button", "repeatable": true,
     "press": [{"cmd": "nasal", "script": "view.panViewDir(-1)"}],
     "match": [["panViewDir\\(\\s*-"], ["^cmd=property-adjust$", "^prop=sim/current-view/goal-heading-offset-deg$", "^step=-"]]},
    {"id": "view.pan-up", "cat": "Vues", "label": "Lever la tête", "kind": "button", "repeatable": true,
     "press": [{"cmd": "nasal", "script": "view.panViewPitch(1)"}],
     "match": [["panViewPitch\\(\\s*\\+?[0-9.]"], ["^cmd=property-adjust$", "^prop=sim/current-view/goal-pitch-offset-deg$", "^step=\\+?[0-9.]"]]},
    {"id": "view.pan-down", "cat": "Vues", "label": "Baisser la tête", "kind": "button", "repeatable": true,
     "press": [{"cmd": "nasal", "script": "view.panViewPitch(-1)"}],
     "match": [["panViewPitch\\(\\s*-"], ["^cmd=property-adjust$", "^prop=sim/current-view/goal-pitch-offset-deg$", "^step=-"]]},
    {"id": "view.look-front", "cat": "Vues", "label": "Regarder devant", "kind": "button",
     "press": [{"cmd": "property-assign", "prop": "/sim/current-view/goal-heading-offset-deg", "prop2": "/sim/view/config/front-direction-deg"}],
     "match": [["^prop=sim/view/config/front-direction-deg$"]]},
    {"id": "view.look-back", "cat": "Vues", "label": "Regarder derrière", "kind": "button",
     "press": [{"cmd": "property-assign", "prop": "/sim/current-view/goal-heading-offset-deg", "prop2": "/sim/view/config/back-direction-deg"}],
     "match": [["^prop=sim/view/config/back-direction-deg$"]]},
    {"id": "view.look-left", "cat": "Vues", "label": "Regarder à gauche", "kind": "button",
     "press": [{"cmd": "property-assign", "prop": "/sim/current-view/goal-heading-offset-deg", "prop2": "/sim/view/config/left-direction-deg"}],
     "match": [["^prop=sim/view/config/left-direction-deg$"]]},
    {"id": "view.look-right", "cat": "Vues", "label": "Regarder à droite", "kind": "button",
     "press": [{"cmd": "property-assign", "prop": "/sim/current-view/goal-heading-offset-deg", "prop2": "/sim/view/config/right-direction-deg"}],
     "match": [["^prop=sim/view/config/right-direction-deg$"]]},
    {"id": "view.cockpit-toggle", "cat": "Vues", "label": "Basculer cockpit 3D / 2D", "kind": "button",
