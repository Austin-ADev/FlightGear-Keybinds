    {"id": "sim.map", "cat": "Simulateur", "label": "Carte", "kind": "button", "press": [{"cmd": "dialog-show", "dialog": "map"}]},
    {"id": "sim.radios", "cat": "Simulateur", "label": "Fenêtre des radios", "kind": "button", "press": [{"cmd": "dialog-show", "dialog": "radios"}]},
    {"id": "sim.quit", "cat": "Simulateur", "label": "Quitter FlightGear", "kind": "button", "press": [{"cmd": "dialog-show", "dialog": "exit"}]},
    {"id": "sim.reset", "cat": "Simulateur", "label": "Réinitialiser le vol", "kind": "button", "press": [{"cmd": "reset"}]},
