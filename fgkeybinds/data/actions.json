{
  "_doc": "Catalog of FlightGear actions known to FGKeybinds. 'press'/'release' describe the bindings (cmd, prop, value, step, factor, offset, script, dialog). 'match': a list of alternatives, each being a list of regular expressions (logical AND) applied to the canonical text of a binding (cmd=, prop=, value=, step=, script=, dialog=... lines). If 'match' is absent, it is inferred from the first binding.",
  "actions": [
    {"id": "axis.aileron", "cat": "Flight controls", "label": "Ailerons (axis)", "kind": "axis",
     "press": [{"cmd": "property-scale", "prop": "/controls/flight/aileron"}],
     "match": [["^cmd=property-scale$", "^prop=controls/flight/aileron$"]]},
    {"id": "axis.elevator", "cat": "Flight controls", "label": "Throttle (axis)", "kind": "axis",
     "press": [{"cmd": "property-scale", "prop": "/controls/flight/elevator", "factor": "-1"}],
     "match": [["^cmd=property-scale$", "^prop=controls/flight/elevator$"]]},
    {"id": "axis.rudder", "cat": "Flight controls", "label": "Direction / palonnier (axe)", "kind": "axis",
     "press": [{"cmd": "property-scale", "prop": "/controls/flight/rudder"}],
     "match": [["^cmd=property-scale$", "^prop=controls/flight/rudder$"]]},
    {"id": "flight.aileron-left", "cat": "Flight controls", "label": "Ailerons à gauche", "kind": "button", "repeatable": true,
     "press": [{"cmd": "nasal", "script": "controls.incAileron(-0.05, -1.0)"}],
     "match": [["incAileron\\(\\s*-"], ["^cmd=property-adjust$", "^prop=controls/flight/aileron$", "^step=-"]]},
